<article class="ql-match ql-match--settled">
  <div class="ql-match__meta">
    <span class="ql-match__num">Match <%= match.number %></span>
    <time class="ql-localtime" datetime="<%= match.kickoff_at.utc.iso8601 %>"><%= match.kickoff_at.utc.strftime("%a %-d %b · %H:%M UTC") %></time>
  </div>
  <div class="ql-match__teams">
    <span class="ql-match__team"><%= match.home_team %></span>
    <span class="ql-match__score"><%= match.finished? ? "#{match.home_score}–#{match.away_score}" : "·" %></span>
    <span class="ql-match__team ql-match__team--away"><%= match.away_team %></span>
  </div>
  <div class="ql-settled">
    <% if pick %>
      <span class="ql-settled__label">Your call</span>
      <span class="ql-settled__value"><%= prediction_label(pick.prediction, match) %></span>
      <% if match.finished? %>
        <span class="ql-settled__mark <%= pick.correct? ? "is-hit" : "is-miss" %>"><%= pick.correct? ? "✓ hit" : "✗ miss" %></span>
      <% end %>
    <% else %>
      <span class="ql-settled__label ql-settled__none">No pick made</span>
    <% end %>
  </div>
</article>
