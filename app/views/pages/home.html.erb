<% content_for :title, "La Quiniela — World Cup 2026 Prediction Pool" %>

<div class="ql">
  <!-- top bar -->
  <header class="ql-top">
    <div class="ql-wrap ql-top__row">
      <div class="ql-top__mark"><span class="ql-top__dot"></span> La Quiniela</div>
      <div class="ql-top__meta">
        <span>Est. MMXXVI</span>
        <span>USA · CAN · MEX</span>
      </div>
    </div>
  </header>

  <!-- LED ticker -->
  <div class="ql-ticker" aria-hidden="true">
    <div class="ql-ticker__track">
      <span><b>Call the upset</b></span><span>·</span><span>104 matches</span><span>·</span><span>48 nations</span><span>·</span><span><b>Picks lock at kickoff</b></span><span>·</span><span>Six friends</span><span>·</span><span>One coupon</span><span>·</span><span><b>Beat the crowd</b></span><span>·</span>
      <span><b>Call the upset</b></span><span>·</span><span>104 matches</span><span>·</span><span>48 nations</span><span>·</span><span><b>Picks lock at kickoff</b></span><span>·</span><span>Six friends</span><span>·</span><span>One coupon</span><span>·</span><span><b>Beat the crowd</b></span><span>·</span>
    </div>
  </div>

  <!-- flash -->
  <% if notice || alert %>
    <div class="ql-flash <%= "is-alert" if alert %>" role="status">
      <div class="ql-wrap"><%= notice || alert %></div>
    </div>
  <% end %>

  <!-- hero -->
  <section class="ql-hero">
    <div class="ql-stamp">
      <small>Rule Nº 1</small>
      <span class="big">Picks Lock</span>
      <small>at kickoff</small>
    </div>
    <div class="ql-wrap ql-hero__grid">
      <div>
        <span class="ql-kicker">FIFA World Cup 2026 · The Friends' Pool</span>
        <h1 class="ql-title">
          <span class="ql-line"><span>Call</span></span>
          <span class="ql-line"><span>the</span></span>
          <span class="ql-line"><span><span class="em">Upset.</span></span></span>
        </h1>
        <p class="ql-lede">
          One pool, six friends, every match called <b>home, draw or away</b>. Your
          points equal the number of people you beat — so the verdict nobody else
          dared is the one that pays out biggest.
        </p>
        <div class="ql-scorelines">
          <% @upcoming_matches.each do |match| %>
            <span class="ql-chip"><b><%= team_code(match.home_team) %></b> v <%= team_code(match.away_team) %></span>
          <% end %>
          <span class="ql-chip ql-chip--live"><span class="ql-pulse" aria-hidden="true"></span> Upset watch</span>
        </div>
      </div>

      <!-- coupon CTA -->
      <% if signed_in? %>
        <div class="ql-coupon ql-coupon--claimed">
          <div class="ql-coupon__head">
            <span>Shared Coupon</span>
            <span class="ql-coupon__no">Nº 0006</span>
          </div>
          <p class="ql-claimed__hi">Stamped for <em><%= current_user.name %></em>.</p>
          <p class="ql-claimed__sub">You're in the pool. Time to call some matches.</p>
          <%= link_to "Make your picks →", picks_path, class: "ql-btn ql-claimed__cta" %>
          <div class="ql-claimed__row">
            <span class="ql-claimed__badge">✓ Claimed</span>
            <%= button_to "Not you?", leave_path, method: :delete, class: "ql-claimed__leave" %>
          </div>
        </div>
      <% else %>
        <%= form_with url: join_path, method: :post, class: "ql-coupon" do |f| %>
          <div class="ql-coupon__head">
            <span>Shared Coupon</span>
            <span class="ql-coupon__no">Nº 0006</span>
          </div>
          <%= f.label :name, "Stake your name", class: "ql-coupon__label" %>
          <div class="ql-field">
            <%= f.text_field :name, placeholder: "e.g. ANA", autocomplete: "off", autofocus: false, class: "ql-input", aria: { label: "Your name" } %>
            <%= f.button "Claim ticket", class: "ql-btn" %>
          </div>
          <p class="ql-coupon__fine">No password · No money · Honour system</p>
        <% end %>
      <% end %>
    </div>
  </section>

  <!-- 01 · how it scores -->
  <section class="ql-sec">
    <div class="ql-wrap">
      <div class="ql-sec__head ql-reveal">
        <span class="ql-sec__no">01</span>
        <h2 class="ql-sec__title">How it scores</h2>
      </div>

      <div class="ql-score">
        <!-- worked ticket -->
        <div class="ql-receipt ql-reveal">
          <div class="ql-receipt__top">
            <span>Match 39 · Group F</span>
            <span>Full time</span>
          </div>
          <div class="ql-receipt__match">
            <span class="ql-receipt__team">Brazil</span>
            <span class="ql-receipt__sc">0–1</span>
            <span class="ql-receipt__team">Mexico</span>
          </div>
          <div class="ql-receipt__ft">— away win —</div>

          <table class="ql-tab">
            <thead>
              <tr><th>Picker</th><th>Called</th><th>Pts</th></tr>
            </thead>
            <tbody>
              <tr class="win"><td>Cara</td><td>Mexico</td><td class="pts">+5</td></tr>
              <tr><td>Ana</td><td>Brazil</td><td>0</td></tr>
              <tr><td>Ben</td><td>Brazil</td><td>0</td></tr>
              <tr><td>Diego</td><td>Draw</td><td>0</td></tr>
              <tr><td>Eva</td><td>Brazil</td><td>0</td></tr>
              <tr><td>Felix</td><td>Brazil</td><td>0</td></tr>
            </tbody>
          </table>

          <div class="ql-verdict">
            <span>Six picked · one called it</span>
            <b>+5</b>
          </div>
        </div>

        <!-- explainer -->
        <div class="ql-explain ql-reveal">
          <p class="ql-explain__big">The crowd is your <em>handicap.</em></p>
          <p>
            Six of you picked this match. One — Cara — took Mexico. When the upset
            landed she didn't just score; she banked the five players she beat.
          </p>
          <p>
            Take the favourite the whole room took and you'll be lucky to clear a
            single point. Back the call no one else saw, and the table pays you out.
          </p>
          <div class="ql-formula">
            POINTS = PICKED − CORRECT<br>
            6 PICKED − 1 RIGHT = <b>+5 FOR THE BRAVE</b>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · house rules -->
  <section class="ql-sec">
    <div class="ql-wrap">
      <div class="ql-sec__head ql-reveal">
        <span class="ql-sec__no">02</span>
        <h2 class="ql-sec__title">House rules</h2>
      </div>

      <div class="ql-rules ql-reveal">
        <div class="ql-rule">
          <span class="ql-rule__no">01</span>
          <h3 class="ql-rule__t">One call per match</h3>
          <p>Home, draw or away — a single verdict for every fixture, yours to change right up to the whistle.</p>
        </div>
        <div class="ql-rule is-key">
          <span class="ql-rule__no">02</span>
          <h3 class="ql-rule__t">Locks at kickoff</h3>
          <p>The first whistle is the deadline. Once the ball rolls the coupon is sealed — no edits, no late nerves.</p>
        </div>
        <div class="ql-rule">
          <span class="ql-rule__no">03</span>
          <h3 class="ql-rule__t">Pure honour</h3>
          <p>No logins, no wallets, no referee. Just your name on the sheet and bragging rights on the line.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 · the field -->
  <section class="ql-sec ql-field-sec">
    <div class="ql-wrap">
      <div class="ql-sec__head ql-reveal">
        <div style="display:flex;align-items:baseline;gap:16px;">
          <span class="ql-sec__no">03</span>
          <h2 class="ql-sec__title">The field</h2>
        </div>
        <%= link_to "Full standings →", leaderboard_path, class: "ql-navlink" %>
      </div>

      <div class="ql-board ql-reveal">
        <div class="ql-board__row lead">
          <span class="ql-board__rk">01</span>
          <span class="ql-board__name">Cara</span>
          <span class="ql-board__pts">12<small>pts</small></span>
        </div>
        <div class="ql-board__row">
          <span class="ql-board__rk">02</span>
          <span class="ql-board__name">Diego</span>
          <span class="ql-board__pts">7<small>pts</small></span>
        </div>
        <div class="ql-board__row">
          <span class="ql-board__rk">03</span>
          <span class="ql-board__name">Ana</span>
          <span class="ql-board__pts">5<small>pts</small></span>
        </div>
        <div class="ql-board__row">
          <span class="ql-board__rk">04</span>
          <span class="ql-board__name">Felix</span>
          <span class="ql-board__pts">4<small>pts</small></span>
        </div>
        <div class="ql-board__row">
          <span class="ql-board__rk">05</span>
          <span class="ql-board__name">Ben</span>
          <span class="ql-board__pts">2<small>pts</small></span>
        </div>
        <div class="ql-board__row">
          <span class="ql-board__rk">06</span>
          <span class="ql-board__name">Eva</span>
          <span class="ql-board__pts">0<small>pts</small></span>
        </div>
      </div>
    </div>
  </section>

  <!-- footer stub -->
  <footer class="ql-foot">
    <div class="ql-wrap ql-foot__row">
      <div class="ql-foot__mark">La <em>Quiniela</em></div>
      <p class="ql-foot__fine">
        Unofficial pool · FIFA World Cup 2026 · 104 matches, 48 nations,
        six friends, one coupon. Picks lock at kickoff.
      </p>
    </div>
  </footer>
</div>

<script>
  (function () {
    function init() {
      // Reveal sections on scroll
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); }
        });
      }, { threshold: 0.18 });
      document.querySelectorAll(".ql-reveal").forEach(function (el) { io.observe(el); });
    }
    document.addEventListener("DOMContentLoaded", init);
    document.addEventListener("turbo:load", init);
    if (document.readyState !== "loading") init();
  })();
</script>
